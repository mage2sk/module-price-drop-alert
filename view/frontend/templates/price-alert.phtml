            <svg x-show="notification.type === 'success'" aria-hidden="true" style="color:#16a34a;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <svg x-show="notification.type === 'error'" aria-hidden="true" style="color:#dc2626;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
            <span x-text="notification.message"></span>
            <button type="button" @click="notification.show = false" class="close" aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>"><svg aria-hidden="true" style="width:0.75rem; height:0.75rem;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></button>
        </div>
    </div>
<?php if ($compact): ?>
        </div>
    </dialog>
<?php endif; ?>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('priceAlertComponent', (productId, currentPrice, customerEmail, customerName, isLoggedIn, allowGuests) => ({
        productId, currentPrice, email: customerEmail, customerName, isLoggedIn, allowGuests,
        targetPrice: '', loading: true, subscribed: false, submitting: false,
        alertData: null, invalid: '', dialogOpen: false, pendingFocus: false,
        notification: { show: false, message: '', type: 'success' },
        notificationTimer: null,
        init() {
            try {
                const sections = JSON.parse(localStorage.getItem('mage-cache-storage') || '{}');
                if (sections.customer && sections.customer.firstname) {
                    this.isLoggedIn = true;
                    this.customerName = sections.customer.firstname + (sections.customer.lastname ? ' ' + sections.customer.lastname : '');
                    if (sections.customer.email) this.email = sections.customer.email;
                }
            } catch (e) {}

            if (this.isLoggedIn && !this.email) {
                fetch(BASE_URL + 'customer/section/load/?sections=customer', { credentials: 'include' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.customer && data.customer.email) this.email = data.customer.email;
                        if (data.customer && data.customer.firstname && !this.customerName) {
                            this.customerName = data.customer.firstname + (data.customer.lastname ? ' ' + data.customer.lastname : '');
                        }
                    }).catch(() => {});
            }

            this.checkStatus();
        },
        focusables() {
            const root = this.$refs.dialog;
            if (!root) return [];
            return [...root.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])')]
                .filter(el => el.getClientRects().length > 0);
        },
        openDialog() {
            const dialog = this.$refs.dialog;
            if (!dialog || dialog.open) return;
            dialog.showModal();
            this.dialogOpen = true;
            this.pendingFocus = true;
            setTimeout(() => this.focusFirst(), 50);
        },
        focusFirst() {
            if (!this.dialogOpen) return;
            const items = this.focusables().filter(el => !el.classList.contains('pa-dialog-close'));
            const first = items.find(el => el.tagName === 'INPUT') || items[0];
            if (first) {
                first.focus();
                this.pendingFocus = false;
            }
        },
        closeDialog() {
            const dialog = this.$refs.dialog;
            if (dialog && dialog.open) dialog.close();
            this.onDialogClose();
        },
        onDialogClose() {
            this.dialogOpen = false;
            this.invalid = '';
            if (this.$refs.trigger) this.$refs.trigger.focus();
        },
        trapFocus(event) {
            const items = this.focusables();
            if (!items.length) return;
            const first = items[0];
            const last = items[items.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        },
        async checkStatus() {
            this.loading = true;
            try {
                const url = new URL('<?= $escaper->escapeJs($block->getStatusUrl()) ?>');
                url.searchParams.append('product_id', this.productId);
                if (this.email) url.searchParams.append('email', this.email);
                const data = await (await fetch(url)).json();
                this.subscribed = data.subscribed || false;
                this.alertData = data.alert || null;
            } catch (e) {
                this.subscribed = false;
            } finally {
                this.loading = false;
                if (this.dialogOpen && this.pendingFocus) this.$nextTick(() => setTimeout(() => this.focusFirst(), 50));
            }
        },
        fieldError(field, message) {
            this.invalid = field;
            this.showNotification(message, 'error');
            const el = document.getElementById('pa-' + field + '-' + this.productId);
            if (el) el.focus();
        },
        focusHeading(ref, tries = 0) {
            const el = this.$refs[ref];
            if (!el) return;
            el.focus();
            if (document.activeElement !== el && tries < 20) {
                setTimeout(() => this.focusHeading(ref, tries + 1), 50);
            }
        },
        async subscribe() {
            if (!this.isLoggedIn && !this.allowGuests) return;
            this.invalid = '';
            if (!this.isLoggedIn && (!this.customerName || !this.customerName.trim()))
                return this.fieldError('name', '<?= $escaper->escapeJs(__('Please enter your name')) ?>');
            if (!this.isLoggedIn && (!this.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.email)))
                return this.fieldError('email', '<?= $escaper->escapeJs(__('Please enter a valid email address')) ?>');
            if (this.targetPrice !== '' && this.targetPrice !== null && !(parseFloat(this.targetPrice) > 0))
                return this.fieldError('target', '<?= $escaper->escapeJs(__('Please enter a valid target price.')) ?>');
            if (this.targetPrice && parseFloat(this.targetPrice) >= this.currentPrice)
                return this.fieldError('target', '<?= $escaper->escapeJs(__('Target price must be lower than current price')) ?>');
            this.submitting = true;
            try {
                const fd = new FormData();
                fd.append('product_id', this.productId);
                if (!this.isLoggedIn) { fd.append('email', this.email); fd.append('customer_name', this.customerName); }
                else if (this.customerName && this.customerName.trim()) fd.append('customer_name', this.customerName);
                if (this.targetPrice) fd.append('trigger_price', this.targetPrice);
                fd.append('form_key', hyva.getFormKey());
                const data = await (await fetch('<?= $escaper->escapeJs($block->getSubscribeUrl()) ?>', { method: 'POST', body: fd })).json();
                if (data.success) {
                    this.targetPrice = '';
                    await this.checkStatus();
                    if (!this.subscribed) { this.subscribed = true; }
                    this.showNotification(data.message || '<?= $escaper->escapeJs(__('Subscribed!')) ?>', 'success');
                    this.focusHeading('activeHeading');
                } else this.showNotification(data.message || '<?= $escaper->escapeJs(__('Failed')) ?>', 'error');
            } catch (e) { this.showNotification('<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error'); } finally { this.submitting = false; }
        },
        async unsubscribe() {
            this.submitting = true;
            try {
                const fd = new FormData();
                fd.append('product_id', this.productId);
                if (!this.isLoggedIn) fd.append('email', this.email);
                fd.append('form_key', hyva.getFormKey());
                const data = await (await fetch('<?= $escaper->escapeJs($block->getUnsubscribeUrl()) ?>', { method: 'POST', body: fd })).json();
                if (data.success) {
                    this.subscribed = false;
                    this.alertData = null;
                    this.showNotification(data.message || '<?= $escaper->escapeJs(__('Unsubscribed')) ?>', 'success');
                    this.focusHeading('formHeading');
                } else this.showNotification(data.message || '<?= $escaper->escapeJs(__('Failed')) ?>', 'error');
            } catch (e) { this.showNotification('<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error'); } finally { this.submitting = false; }
        },
        formatPrice(p) { return <?= /* @noEscape */ json_encode($currencySymbol, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?> + parseFloat(p).toFixed(2); },
        showNotification(message, type) {
            clearTimeout(this.notificationTimer);
            this.notification = { show: true, message, type };
            this.notificationTimer = setTimeout(() => { this.notification.show = false; }, 5000);
        }
    }));
});
</script>

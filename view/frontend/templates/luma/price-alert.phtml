<script>
document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    var uid = '<?= $escaper->escapeJs($uid) ?>';
    var productId = <?= (int)$productId ?>;
    var currentPrice = <?= (float)$currentPrice ?>;
    var allowGuests = <?= $allowGuests ? 'true' : 'false' ?>;
    var currencySymbol = <?= /* @noEscape */ json_encode($currencySymbol, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var statusUrl = '<?= $escaper->escapeJs($block->getStatusUrl()) ?>';
    var isLoggedIn = false;
    var customerEmail = '';
    var $ = function(suffix) { return document.getElementById(uid + suffix); };

    var formEl = $('-form');
    var subscribedEl = $('-subscribed');
    var toast = $('-toast');
    var btn = $('-btn');
    var form = $('-subscribe-form');
    var unsubBtn = $('-unsub');
    var fieldsEl = $('-fields');
    var toastTimer;
    var dialog = $('-dialog');
    var trigger = $('-trigger');
    var labelOff = '<?= $escaper->escapeJs(__('Notify me of a price drop')) ?>';
    var labelOn = '<?= $escaper->escapeJs(__('Price drop alert is on')) ?>';

    function setTrigger(on) {
        if (!trigger) return;
        trigger.querySelector('span').textContent = on ? labelOn : labelOff;
        trigger.querySelector('.pa-trigger-bell').style.display = on ? 'none' : '';
        trigger.querySelector('.pa-trigger-check').style.display = on ? '' : 'none';
    }

    function focusables() {
        return Array.prototype.filter.call(
            dialog.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'),
            function(el) { return el.getClientRects().length > 0; }
        );
    }

    if (dialog && trigger && typeof dialog.showModal === 'function') {
        trigger.addEventListener('click', function() {
            if (dialog.open) return;
            dialog.showModal();
            trigger.setAttribute('aria-expanded', 'true');
            var items = focusables().filter(function(el) { return el.className.indexOf('pa-dialog-close') === -1; });
            var first = items.filter(function(el) { return el.tagName === 'INPUT'; })[0] || items[0];
            if (first) first.focus();
        });
        var afterClose = function() {
            trigger.setAttribute('aria-expanded', 'false');
            trigger.focus();
        };
        var closeDialog = function() {
            if (dialog.open) dialog.close();
            afterClose();
        };
        dialog.addEventListener('close', afterClose);
        dialog.addEventListener('cancel', afterClose);
        dialog.addEventListener('click', function(e) { if (e.target === dialog) closeDialog(); });
        $('-dialog-close').addEventListener('click', closeDialog);
        dialog.addEventListener('keydown', function(e) {
            if (e.key !== 'Tab') return;
            var items = focusables();
            if (!items.length) return;
            var first = items[0];
            var last = items[items.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });
    }

    try {
        var sections = JSON.parse(localStorage.getItem('mage-cache-storage') || '{}');
        if (sections.customer && sections.customer.firstname) {
            isLoggedIn = true;
            customerEmail = sections.customer.email || '';
            var guestFields = $('-guest-fields');
            var loginEl = $('-login');
            var loggedMsg = $('-logged-msg');
            if (guestFields) { guestFields.style.display = 'none'; }
            if (loginEl) { loginEl.style.display = 'none'; }
            if (fieldsEl) { fieldsEl.style.display = ''; }
            if (loggedMsg && customerEmail) {
                loggedMsg.style.display = '';
                $('-logged-email').textContent = customerEmail;
            }
        }
    } catch (e) {}

    function getFormKey() {
        var m = document.cookie.match(/form_key=([^;]+)/);
        if (m) return m[1];
        var el = document.querySelector('input[name="form_key"]');
        return el ? el.value : '';
    }

    function showToast(msg, type) {
        if (toastTimer) clearTimeout(toastTimer);
        toast.className = 'pa-toast visible ' + type;
        toast.querySelector('.pa-toast-msg').textContent = msg;
        toast.querySelector('.pa-toast-ok').style.display = type === 'success' ? '' : 'none';
        toast.querySelector('.pa-toast-err').style.display = type === 'error' ? '' : 'none';
        toastTimer = setTimeout(function() { toast.className = 'pa-toast'; }, 5000);
    }

    function focusLater(el) {
        if (el) setTimeout(function() { el.focus(); }, 50);
    }

    function setTarget(value) {
        var t = $('-sub-target');
        if (!t) return;
        if (value) {
            t.querySelector('strong').textContent = currencySymbol + parseFloat(value).toFixed(2);
            t.style.display = '';
        } else {
            t.style.display = 'none';
        }
    }

    function showSubscribed(target) {
        setTarget(target);
        formEl.style.display = 'none';
        subscribedEl.style.display = '';
        setTrigger(true);
    }

    function showForm() {
        subscribedEl.style.display = 'none';
        formEl.style.display = '';
        setTrigger(false);
    }

    function fieldError(input, msg) {
        if (input) {
            input.setAttribute('aria-invalid', 'true');
            input.focus();
        }
        showToast(msg, 'error');
    }

    function clearInvalid() {
        form.querySelectorAll('[aria-invalid]').forEach(function(el) { el.removeAttribute('aria-invalid'); });
    }

    function post(url, fd, onDone) {
        var xhr = new XMLHttpRequest();
        xhr.open('POST', url);
        xhr.withCredentials = true;
        xhr.onload = function() {
            var data = null;
            try { data = JSON.parse(xhr.responseText); } catch (ex) {}
            onDone(data);
        };
        xhr.onerror = function() { onDone(null); };
        xhr.send(fd);
    }

    function resetBtn() {
        btn.disabled = false;
        btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Notify Me When Price Drops')) ?>';
    }

    toast.querySelector('.close').addEventListener('click', function() { toast.className = 'pa-toast'; });

    (function checkStatus() {
        var xhr = new XMLHttpRequest();
        var url = statusUrl + (statusUrl.indexOf('?') === -1 ? '?' : '&') + 'product_id=' + encodeURIComponent(productId);
        xhr.open('GET', url);
        xhr.withCredentials = true;
        xhr.onload = function() {
            try {
                var data = JSON.parse(xhr.responseText);
                if (data && data.subscribed) {
                    showSubscribed(data.alert ? data.alert.trigger_price : null);
                }
            } catch (ex) {}
        };
        xhr.send();
    })();

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!isLoggedIn && !allowGuests) return;
        clearInvalid();
        var fd = new FormData();
        fd.append('product_id', productId);
        fd.append('form_key', getFormKey());
        if (!isLoggedIn) {
            var name = $('-name');
            var email = $('-email');
            if (!name || !name.value.trim()) {
                return fieldError(name, '<?= $escaper->escapeJs(__('Please enter your name')) ?>');
            }
            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
                return fieldError(email, '<?= $escaper->escapeJs(__('Please enter a valid email address')) ?>');
            }
            fd.append('customer_name', name.value);
            fd.append('email', email.value.trim());
        }
        var target = $('-target');
        var targetValue = target && target.value !== '' ? parseFloat(target.value) : null;
        if (target && target.value !== '' && !(targetValue > 0)) {
            return fieldError(target, '<?= $escaper->escapeJs(__('Please enter a valid target price.')) ?>');
        }
        if (targetValue !== null && targetValue >= currentPrice) {
            return fieldError(target, '<?= $escaper->escapeJs(__('Target price must be lower than current price')) ?>');
        }
        if (targetValue !== null) fd.append('target_price', target.value);

        btn.disabled = true;
        btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Subscribing...')) ?>';

        post('<?= $escaper->escapeJs($block->getSubscribeUrl()) ?>', fd, function(data) {
            resetBtn();
            if (data && data.success) {
                showSubscribed(targetValue);
                if (target) target.value = '';
                showToast(data.message || '<?= $escaper->escapeJs(__('Price alert set!')) ?>', 'success');
                focusLater($('-active-heading'));
            } else {
                showToast((data && data.message) || '<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error');
            }
        });
    });

    if (unsubBtn) {
        unsubBtn.addEventListener('click', function() {
            var fd = new FormData();
            fd.append('product_id', productId);
            fd.append('form_key', getFormKey());
            unsubBtn.textContent = '<?= $escaper->escapeJs(__('Removing...')) ?>';
            unsubBtn.disabled = true;
            post('<?= $escaper->escapeJs($block->getUnsubscribeUrl()) ?>', fd, function(data) {
                unsubBtn.textContent = '<?= $escaper->escapeJs(__('Remove')) ?>';
                unsubBtn.disabled = false;
                if (data && data.success) {
                    showForm();
                    showToast(data.message || '<?= $escaper->escapeJs(__('Unsubscribed')) ?>', 'success');
                    focusLater($('-form-heading'));
                } else {
                    showToast((data && data.message) || '<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error');
                }
            });
        });
    }
});
</script>
